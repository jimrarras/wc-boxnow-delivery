# BOX NOW API credentials (staging).
# Copy to .env and fill in your values. .env is gitignored.
BOXNOW_API_URL=api-stage.boxnow.gr
BOXNOW_CLIENT_ID=
BOXNOW_CLIENT_SECRET=
BOXNOW_PARTNER_ID=

# Set to 1 to allow integration tests that CREATE real staging parcels.
# Leave unset for read-only integration runs.
BOXNOW_ALLOW_WRITE_TESTS=
