{
    "name": "wc-boxnow-delivery/wc-boxnow-delivery",
    "description": "BOX NOW Delivery for WooCommerce",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6"
    },
    "autoload-dev": {
        "psr-4": {
            "WC_BoxNow_Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": false
        },
        "platform": {
            "php": "8.1.34"
        }
    }
}
