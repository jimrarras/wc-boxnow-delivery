msgid "BOX NOW: bulk voucher skipped, this order already has a voucher from %s. Use the order screen to override."
msgstr "BOX NOW: η μαζική δημιουργία voucher παραλείφθηκε, η παραγγελία έχει ήδη voucher από %s. Για να την παρακάμψετε, χρησιμοποιήστε την οθόνη της παραγγελίας."

#: includes/class-boxnow-voucher.php:1192
msgid "BOX NOW: bulk voucher skipped. This order also ships with %s; create the voucher by hand and collect the cash on delivery only once."
msgstr "BOX NOW: η μαζική δημιουργία voucher παραλείφθηκε. Αυτή η παραγγελία αποστέλλεται και με %s· δημιουργήστε το voucher χειροκίνητα και εισπράξτε την αντικαταβολή μόνο μία φορά."

#: includes/class-boxnow-voucher.php:1274
msgid "%d BOX NOW voucher created."
msgid_plural "%d BOX NOW vouchers created."
msgstr[0] "Δημιουργήθηκε %d voucher BOX NOW."
msgstr[1] "Δημιουργήθηκαν %d voucher BOX NOW."

#: includes/class-boxnow-voucher.php:1280
msgid "%d order skipped because it is not a BOX NOW order, already has a voucher, also ships with another carrier, or voucher creation failed."
msgid_plural "%d orders skipped because they are not BOX NOW orders, already have a voucher, also ship with another carrier, or voucher creation failed."
msgstr[0] "%d παραγγελία παραλείφθηκε επειδή δεν είναι παραγγελία BOX NOW, έχει ήδη voucher, αποστέλλεται και με άλλη μεταφορική, ή η δημιουργία voucher απέτυχε."
msgstr[1] "%d παραγγελίες παραλείφθηκαν επειδή δεν είναι παραγγελίες BOX NOW, έχουν ήδη voucher, αποστέλλονται και με άλλη μεταφορική, ή η δημιουργία voucher απέτυχε."

#: includes/class-boxnow-voucher.php:1286
msgid "%d of them has an order note that says why."
msgid_plural "%d of them have an order note that says why."
msgstr[0] "%d από αυτές έχει σημείωση παραγγελίας που εξηγεί τον λόγο."
msgstr[1] "%d από αυτές έχουν σημείωση παραγγελίας που εξηγεί τον λόγο."

#: includes/class-boxnow-voucher.php:1602
msgid "%1$d order was left out of \"ACS: Create Vouchers\" because it ships with BOX NOW or has BOX NOW vouchers: %2$s. To ship it with ACS anyway, use Create Voucher in the ACS box on the order."
msgid_plural "%1$d orders were left out of \"ACS: Create Vouchers\" because they ship with BOX NOW or have BOX NOW vouchers: %2$s. To ship one with ACS anyway, use Create Voucher in the ACS box on the order."
msgstr[0] "%1$d παραγγελία εξαιρέθηκε από το \"ACS: Δημιουργία Voucher\" επειδή αποστέλλεται με BOX NOW ή έχει voucher BOX NOW: %2$s. Για να την αποστείλετε παρ' όλα αυτά με ACS, χρησιμοποιήστε τη Δημιουργία Voucher στο πλαίσιο ACS της παραγγελίας."
msgstr[1] "%1$d παραγγελίες εξαιρέθηκαν από το \"ACS: Δημιουργία Voucher\" επειδή αποστέλλονται με BOX NOW ή έχουν voucher BOX NOW: %2$s. Για να αποστείλετε μία από αυτές παρ' όλα αυτά με ACS, χρησιμοποιήστε τη Δημιουργία Voucher στο πλαίσιο ACS της παραγγελίας."

